   "lang": "zh",
   "start": 44.906,
   "end": 46.216
  },
  {
   "voice": "女2",
   "text": "Arturo, el profesor Vicente se marcha a Sevilla el viernes.",
   "where": "Texto 1 第1遍",
   "lang": "es",
   "start": 47.016,
   "end": 50.566
  },
  {
   "voice": "女2",
   "text": "¿Qué le regalamos?",
   "where": "Texto 1 第1遍",
   "lang": "es",
   "start": 50.916,
   "end": 52.07
  },
  {
   "voice": "男2",
   "text": "Yo pensaba en unas flores, pero no puede llevarlas en el avión.",
   "where": "Texto 1 第1遍",
   "lang": "es",
   "start": 52.67,
   "end": 56.68
  },
  {
   "voice": "女2",
   "text": "Tienes razón.",
   "where": "Texto 1 第1遍",
   "lang": "es",
   "start": 57.28,
   "end": 58.152
  },
  {
   "voice": "女2",
   "text": "¿Y un libro de fotos de Pekín?",
