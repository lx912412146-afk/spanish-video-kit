   "lang": "zh",
   "start": 101.42,
   "end": 102.643
  },
  {
   "voice": "男1",
   "text": "Cristina, ¿a qué hora sale tu avión para Lima?",
   "where": "Texto 2 第1遍",
   "lang": "es",
   "start": 103.443,
   "end": 106.403
  },
  {
   "voice": "女3",
   "text": "A las once de la noche.",
   "where": "Texto 2 第1遍",
   "lang": "es",
   "start": 107.003,
   "end": 108.79
  },
  {
   "voice": "女3",
   "text": "Tengo que estar en el aeropuerto a las nueve.",
   "where": "Texto 2 第1遍",
   "lang": "es",
   "start": 109.14,
   "end": 112.11
  },
  {
   "voice": "男1",
   "text": "Entonces saldremos de casa a las siete y media.",
   "where": "Texto 2 第1遍",
   "lang": "es",
   "start": 112.71,
   "end": 115.74
  },
  {
   "voice": "男1",
   "text": "Con el tráfico, tardaremos una hora.",
   "where": "Texto 2 第1遍",
   "lang": "es",
   "start": 116.09,
   "end": 118.46
  },
  {
   "voice": "女3",
   "text": "Muy bien.",
   "where": "Texto 2 第1遍",
   "lang": "es",
   "start": 119.06,
   "end": 120.25
  },
  {
   "voice": "女3",
