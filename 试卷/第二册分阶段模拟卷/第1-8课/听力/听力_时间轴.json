   "start": 44.906,
   "end": 46.216
  },
  {
   "voice": "女2",
   "text": "Esteban, el taxi vendrá a las seis.",
   "where": "Texto 1 第1遍",
   "lang": "es",
   "start": 47.016,
   "end": 49.533
  },
  {
   "voice": "女2",
   "text": "¿Ya tienes la maleta hecha?",
   "where": "Texto 1 第1遍",
   "lang": "es",
   "start": 49.883,
   "end": 51.297
  },
  {
   "voice": "男2",
   "text": "Casi.",
   "where": "Texto 1 第1遍",
   "lang": "es",
   "start": 51.897,
   "end": 52.477
  },
  {
   "voice": "男2",
   "text": "La ropa y los zapatos ya están dentro.",
   "where": "Texto 1 第1遍",
   "lang": "es",
   "start": 52.827,
   "end": 55.737
  },
  {
   "voice": "男2",
   "text": "Solo me faltan los libros.",
   "where": "Texto 1 第1遍",
   "lang": "es",
   "start": 56.087,
   "end": 58.107
  },
  {
   "voice": "女2",
   "text": "¿Y el pasaporte?",
   "where": "Texto 1 第1遍",
   "lang": "es",
   "start": 58.707,
   "end": 59.594
  },
  {
   "voice": "女2",
   "text": "No lo metas en la maleta.",
   "where": "Texto 1 第1遍",
   "lang": "es",
   "start": 59.944,
   "end": 61.327
  },
  {
   "voice": "女2",
   "text": "Llévalo contigo.",
   "where": "Texto 1 第1遍",
   "lang": "es",
   "start": 61.677,
   "end": 62.562
  },
  {
   "voice": "男2",
   "text": "Sí, claro.",
   "where": "Texto 1 第1遍",
   "lang": "es",
   "start": 63.162,
   "end": 64.186
  },
  {
   "voice": "男2",
   "text": "Lo llevaré conmigo, con el billete de avión.",
