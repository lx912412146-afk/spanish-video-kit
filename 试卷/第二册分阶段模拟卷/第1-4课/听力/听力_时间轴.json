   "text": "第一段录音。",
   "where": "指令语",
   "lang": "zh",
   "start": 44.906,
   "end": 46.216
  },
  {
   "voice": "女2",
   "text": "Buenos días, señor.",
   "where": "Texto 1 第1遍",
   "lang": "es",
   "start": 47.016,
   "end": 48.204
  },
  {
   "voice": "女2",
   "text": "¿Qué tal la noche?",
   "where": "Texto 1 第1遍",
   "lang": "es",
   "start": 48.554,
   "end": 49.534
  },
  {
   "voice": "男2",
   "text": "Bastante mal.",
   "where": "Texto 1 第1遍",
   "lang": "es",
   "start": 50.134,
   "end": 51.354
  },
  {
   "voice": "男2",
   "text": "La cama era muy cómoda y no se oía ningún ruido, pero hacía muchísimo frío.",
   "where": "Texto 1 第1遍",
   "lang": "es",
   "start": 51.704,
   "end": 57.184
  },
  {
   "voice": "女2",
   "text": "¡Vaya!",
   "where": "Texto 1 第1遍",
   "lang": "es",
   "start": 57.784,
   "end": 58.474
  },
  {
   "voice": "女2",
   "text": "¿Estaba abierta la ventana?",
   "where": "Texto 1 第1遍",
   "lang": "es",
   "start": 58.824,
   "end": 60.663
  },
  {
   "voice": "男2",
   "text": "No, estaba cerrada.",
   "where": "Texto 1 第1遍",
   "lang": "es",
   "start": 61.263,
   "end": 63.003
  },
  {
   "voice": "男2",
   "text": "Pero la calefacción estaba rota.",
   "where": "Texto 1 第1遍",
   "lang": "es",
   "start": 63.353,
   "end": 65.763
  },
  {
   "voice": "女2",
   "text": "Lo siento mucho, señor.",
   "where": "Texto 1 第1遍",
   "lang": "es",
   "start": 66.363,
   "end": 67.594
  },
  {
   "voice": "女2",
   "text": "Esta noche le damos otra habitación.",
   "where": "Texto 1 第1遍",
   "lang": "es",
   "start": 67.944,
   "end": 69.907
  },
