   "text": "Perdone, señorita.",
   "where": "Texto 5 第1遍",
   "lang": "es",
   "start": 271.952,
   "end": 273.622
  },
  {
   "voice": "男2",
   "text": "Acabo de llegar de Bogotá y me falta una maleta.",
