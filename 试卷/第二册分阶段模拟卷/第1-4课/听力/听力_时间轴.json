   "lang": "es",
   "start": 116.429,
   "end": 118.099
  },
  {
   "voice": "女3",
   "text": "No, once.",
   "where": "Texto 2 第1遍",
   "lang": "es",
   "start": 118.699,
   "end": 119.979
  },
  {
   "voice": "女3",
   "text": "Acaba de llegar otra turista de Lima y viene con nosotros.",
   "where": "Texto 2 第1遍",
   "lang": "es",
   "start": 120.329,
   "end": 124.009
  },
  {
   "voice": "男1",
