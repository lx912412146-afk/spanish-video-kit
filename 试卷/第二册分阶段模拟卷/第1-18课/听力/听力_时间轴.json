  {
   "voice": "女2",
   "text": "Armando, ¿qué tal la visita al castillo ayer?",
   "where": "Texto 1 第1遍",
   "lang": "es",
   "start": 47.016,
   "end": 49.667
  },
  {
   "voice": "男2",
   "text": "Fatal.",
   "where": "Texto 1 第1遍",
   "lang": "es",
   "start": 50.267,
   "end": 51.437
  },
  {
   "voice": "男2",
   "text": "Cuando llegamos, ya lo habían cerrado.",
   "where": "Texto 1 第1遍",
   "lang": "es",
   "start": 51.787,
   "end": 54.407
  },
  {
   "voice": "女2",
   "text": "¡Vaya!",
   "where": "Texto 1 第1遍",
   "lang": "es",
   "start": 55.007,
   "end": 55.697
  },
  {
   "voice": "女2",
   "text": "¿Llegasteis después de las seis?",
   "where": "Texto 1 第1遍",
   "lang": "es",
   "start": 56.047,
   "end": 57.745
  },
  {
   "voice": "男2",
   "text": "No, llegamos a la una.",
   "where": "Texto 1 第1遍",
   "lang": "es",
   "start": 58.345,
   "end": 60.305
  },
  {
   "voice": "男2",
   "text": "Normalmente cierran a las seis, pero ayer cerraron a las doce por la fiesta.",
   "where": "Texto 1 第1遍",
   "lang": "es",
   "start": 60.655,
   "end": 65.625
  },
  {
