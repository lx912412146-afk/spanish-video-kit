   "start": 97.235,
   "end": 98.458
  },
  {
   "voice": "男1",
   "text": "Perdone, ¿cuándo fue construida esta iglesia?",
   "where": "Texto 2 第1遍",
   "lang": "es",
   "start": 99.258,
   "end": 102.148
  },
  {
   "voice": "女3",
   "text": "La primera iglesia fue construida en mil doscientos diez, pero fue destruida en una guerra.",
   "where": "Texto 2 第1遍",
   "lang": "es",
   "start": 102.748,
   "end": 108.699
  },
  {
   "voice": "男1",
   "text": "¿Y la que vemos ahora?",
   "where": "Texto 2 第1遍",
   "lang": "es",
   "start": 109.299,
   "end": 111.209
  },
  {
   "voice": "女3",
   "text": "Es de mil cuatrocientos noventa.",
