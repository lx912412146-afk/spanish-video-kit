   "lang": "es",
   "start": 533.147,
   "end": 535.387
  },
  {
   "voice": "男1",
   "text": "Volvió a casa riéndose de sí mismo.",
   "where": "Texto 7 第1遍",
   "lang": "es",
   "start": 535.737,
   "end": 538.084
  },
