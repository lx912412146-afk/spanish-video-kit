  {
   "voice": "男1",
   "text": "Fátima, ¿sabes qué le pasó la semana pasada a mi tío Emilio?",
   "where": "Texto 7 第1遍",
   "lang": "es",
   "start": 502.349,
   "end": 506.219
  },
  {
   "voice": "女3",
   "text": "No, cuéntamelo.",
   "where": "Texto 7 第1遍",
   "lang": "es",
   "start": 506.819,
   "end": 508.123
  },
  {
   "voice": "女3",
   "text": "Tu tío siempre tiene historias divertidas.",
   "where": "Texto 7 第1遍",
   "lang": "es",
   "start": 508.473,
   "end": 510.963
  },
  {
   "voice": "男1",
   "text": "Fue al aeropuerto a buscar a un amigo mexicano.",
   "where": "Texto 7 第1遍",
   "lang": "es",
   "start": 511.563,
   "end": 514.447
  },
  {
   "voice": "男1",
   "text": "Lo esperó dos horas, pero su amigo no salía.",
   "where": "Texto 7 第1遍",
   "lang": "es",
   "start": 514.797,
   "end": 517.647
  },
  {
   "voice": "女3",
   "text": "¿Llegó tarde el avión?",
   "where": "Texto 7 第1遍",
   "lang": "es",
   "start": 518.247,
   "end": 519.827
  },
  {
   "voice": "女3",
   "text": "¿O su amigo lo perdió?",
   "where": "Texto 7 第1遍",
   "lang": "es",
   "start": 520.177,
   "end": 521.735
  },
  {
   "voice": "男1",
   "text": "Ni una cosa ni la otra.",
   "where": "Texto 7 第1遍",
   "lang": "es",
   "start": 522.335,
   "end": 524.225
  },
  {
   "voice": "男1",
   "text": "Su amigo llegaba al día siguiente.",
   "where": "Texto 7 第1遍",
   "lang": "es",
   "start": 524.575,
   "end": 526.443
  },
  {
   "voice": "男1",
   "text": "¡Mi tío leyó mal la fecha!",
