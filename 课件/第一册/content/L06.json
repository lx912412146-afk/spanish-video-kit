  "text": {
    "title": "¿Cuántos sois en tu familia?",
    "note": "仿照本课课文编写",
    "lines": [
      {
        "who": "A",
        "es": "Pepe, ¿cuántos sois en tu familia?",
        "zh": "佩佩，你家有几口人？"
      },
      {
        "who": "B",
        "es": "Somos seis: mis abuelos, mis padres, mi hermana y yo.",
        "zh": "六口：祖父母、父母、妹妹和我。"
      },
      {
        "who": "A",
        "es": "¿Cuántos años tiene tu hermana?",
        "zh": "你妹妹几岁？"
      },
      {
        "who": "B",
        "es": "Tiene ocho años. Es pequeña y muy simpática.",
        "zh": "八岁。她年纪小，很可爱。"
      },
      {
        "who": "A",
        "es": "¿Es rubia?",
        "zh": "她是金发吗？"
      },
      {
        "who": "B",
        "es": "No, es morena. Tiene el pelo negro y los ojos grandes.",
        "zh": "不是，她是黑头发，眼睛大大的。"
      },
      {
        "who": "A",
        "es": "¿Y tú? ¿Cuántos años tienes?",
        "zh": "你呢？你多大了？"
      },
      {
        "who": "B",
        "es": "Tengo quince años. ¿Y vosotros? ¿Cuántos sois?",
        "zh": "我十五岁。你们家呢？几口人？"
      },
      {
        "who": "A",
        "es": "Somos tres: mi padre, mi madre y yo. No tengo hermanos.",
        "zh": "三口：爸爸、妈妈和我。我没有兄弟姐妹。"
      },
      {
        "who": "B",
        "es": "¿Cómo es tu padre?",
        "zh": "你爸爸长什么样？"
      },
      {
        "who": "A",
        "es": "Es alto y delgado. Tiene el pelo rubio y los ojos azules.",
        "zh": "他又高又瘦，金头发，蓝眼睛。"
      },
      {
        "who": "B",
        "es": "¿Está en casa tu padre?",
        "zh": "你爸爸在家吗？"
      },
      {
        "who": "A",
        "es": "No, está en el hospital. Es médico.",
        "zh": "不在，他在医院。他是医生。"
      }
    ]
  },
  "grammar": [
    {
      "title": "¿cuántos? 和数词 1–15",
      "points": [
        "¿cuántos? / ¿cuántas? 与名词性一致：¿cuántas faldas?",
        "问一家几口人：¿Cuántos sois? —Somos cinco.（ser + 数目）",
        "uno 在名词前变 un / una：un hermano，una hermana。",
        "其他数词没有阴阳性，放在名词前：tres hermanos，tres hermanas。"
      ],
      "table": {
        "head": [
          "1–5",
          "6–10",
          "11–15"
        ],
        "rows": [
          [
            "1 uno",
            "6 seis",
            "11 once"
          ],
          [
            "2 dos",
            "7 siete",
            "12 doce"
          ],
          [
            "3 tres",
            "8 ocho",
            "13 trece"
          ],
          [
            "4 cuatro",
            "9 nueve",
            "14 catorce"
          ],
          [
            "5 cinco",
            "10 diez",
            "15 quince"
          ]
        ]
      },
      "examples": [
        [
          "¿Cuántos sois en tu familia? —Somos cinco.",
          "你家有几口人？——五口。"
        ],
        [
          "¿Cuántas faldas tienes? —Tengo tres.",
          "你有几条裙子？——三条。"
        ],
        [
          "Tengo un hermano y una hermana.",
          "我有一个兄弟和一个姐妹。"
        ]
      ]
    },
    {
      "title": "tener … años 表示年龄",
      "points": [
        "年龄用 tener + 数目 + años，不用 ser：Tengo diez años.",
        "问年龄：¿Cuántos años tienes / tiene usted?",
        "一岁说 un año：Mi hermano tiene un año.",
        "mayor、menor 阴阳同形：hermana mayor 姐姐。"
      ],
      "examples": [
        [
          "¿Cuántos años tienes? —Tengo catorce años.",
          "你几岁了？——十四岁。"
        ],
        [
          "Mi hermana menor tiene ocho años.",
          "我妹妹八岁。"
        ],
        [
          "¿Cuántos años tiene el niño? —Tiene un año.",
          "那个孩子几岁？——一岁。"
        ]
      ]
    },
    {
      "title": "ser、estar、tener 描述人",
      "points": [
        "ser + 形容词说外貌、性格：Es alto. Es rubia. Es joven.",
        "estar 说一时的状态和位置：Está cansado. Está en casa.",
        "tener 也说外貌：Tiene los ojos azules.",
        "用 tener 说头发、眼睛时加定冠词 el、los，不用 su。"
      ],
      "table": {
        "head": [
          "ser",
          "estar",
          "tener"
        ],
        "rows": [
          [
            "Es alto.",
            "Está cansado.",
            "Tiene diez años."
          ],
          [
            "Es rubia.",
            "Está en casa.",
            "Tiene el pelo negro."
          ]
        ]
      },
      "examples": [
        [
          "Mi padre es alto y moreno.",
          "我父亲个子高，黑头发。"
        ],
        [
          "Mi madre está cansada.",
          "我母亲累了。"
        ],
        [
          "Ana tiene el pelo rubio y los ojos azules.",
          "安娜金头发，蓝眼睛。"
